# Supabase 프로젝트 설정 → Data API / API Keys 에서 확인
# 두 값 모두 브라우저에 노출되는 공개 값입니다. RLS가 실제 접근 통제를 담당합니다.
NEXT_PUBLIC_SUPABASE_URL=https://kxswtjqaqjpgbfcqxhyu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 예전 프로젝트라 publishable 키가 없다면 아래 anon 키를 대신 사용하세요.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 회원가입 확인 메일의 링크가 돌아올 주소.
# 로컬은 http://localhost:3000, Vercel은 실제 배포 도메인을 넣습니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 아래 값은 애플리케이션이 쓰지 않습니다. 절대 이 파일이나 코드에 넣지 마세요.
#   - service_role / sb_secret_... 키 : RLS를 통째로 우회합니다.
#   - SUPABASE_ACCESS_TOKEN (sbp_...)  : Supabase MCP 서버 전용.
#     OS 사용자 환경변수로만 설정하세요 (아래 참고).
#       PowerShell:  setx SUPABASE_ACCESS_TOKEN "sbp_..."
# ---------------------------------------------------------------------------
